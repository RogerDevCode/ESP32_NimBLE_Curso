# Configuración predeterminada para el Proyecto 2 - BLE Advertising
# Este archivo establece las configuraciones necesarias para NimBLE

# Habilitar Bluetooth
CONFIG_BT_ENABLED=y

# Seleccionar el controlador Bluetooth (usar el controlador de Bluedroid)
CONFIG_BT_CONTROLLER_ENABLED=y

# Habilitar el modo BLE
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Configuración de NimBLE
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Configuración de GAP (Generic Access Profile)
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=8

# Configuración de logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y

# Configuración del transporte
CONFIG_BT_NIMBLE_TRANSPORT_UART=n

# Memoria y optimización
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320

# Habilitar servicios GAP y GATT por defecto
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESP32-NimBLE"
